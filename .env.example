# ============================================
# NAILBOOK — Environment Variables
# Copie para .env e preencha com os seus valores
# NUNCA commitar .env para o GitHub!
# ============================================

# ---- Database ----
DATABASE_URL=postgresql://user:password@host:5432/nailbook

# ---- JWT ----
JWT_SECRET=coloque-uma-string-secreta-muito-longa-e-aleatoria-minimo-32-caracteres
JWT_REFRESH_SECRET=coloque-outra-string-secreta-muito-longa-e-aleatoria-minimo-32-caracteres

# ---- CORS / Domínios ----
CORS_ORIGIN=https://www.meudominio.pt,https://meudominio.pt
APP_URL=https://www.meudominio.pt
API_URL=https://api.meudominio.pt

# ---- Server ----
PORT=3000
NODE_ENV=production
TIMEZONE=Europe/Lisbon

# ---- Email (Resend, SendGrid, SES ou SMTP) ----
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=NailBook <contacto@exemplo.com>
EMAIL_REPLY_TO=contacto@exemplo.com

# ---- Notifications ----
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=60000
REMINDER_24H_ENABLED=true
REMINDER_2H_ENABLED=true
ADMIN_NOTIFICATION_EMAIL=admin@exemplo.com

# ---- Calendar ----
ICS_ENABLED=true
CALENDAR_LOCATION=Rua Exemplo, Lisboa

# ---- WhatsApp (futuro) ----
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# ---- Admin Inicial ----
INITIAL_ADMIN_EMAIL=admin@exemplo.com
INITIAL_ADMIN_PASSWORD=MudeEstaSenha123!

# ---- Configurações de Negócio (seed) ----
BUSINESS_NAME=NailBook
BUSINESS_PHONE=+351912345678
BUSINESS_EMAIL=contacto@exemplo.com

# ---- Regras de Marcação ----
MINIMUM_ADVANCE_HOURS=0
MAXIMUM_BOOKING_DAYS=30
CANCELLATION_DEADLINE_HOURS=24
MIN_INTERVAL_MINUTES=15
BUFFER_MINUTES=15

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_BOOKING_MAX=20

# ---- CSRF ----
CSRF_TOKEN_SECRET=coloque-outra-string-secreta-para-csrf-minimo-32-caracteres
